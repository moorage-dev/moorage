{
	"name": "@moorage/plugin-seo",
	"version": "0.0.0",
	"description": "SEO for EmDash: schema markup, structured data, Google preview, noindex rules, redirects import and SEO checks. A Yoast alternative.",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"seo",
		"schema markup",
		"structured data",
		"json-ld",
		"yoast alternative"
	],
	"license": "FSL-1.1-MIT",
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.2.0"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "catalog:",
		"@emdash-cms/plugin-test": "catalog:",
		"@moorage/typescript-config": "workspace:*",
		"emdash": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
