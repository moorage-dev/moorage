{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "seo",
	// Listing text. Registry search matches exact phrases in name, description,
	// keywords and sections, so the phrases people type appear verbatim.
	"name": "SEO & Schema Markup",
	"description": "SEO for EmDash: schema markup, JSON-LD structured data, Google preview, SEO checks, noindex, WordPress redirects import. Yoast alternative.",
	"keywords": [
		"seo",
		"schema markup",
		"structured data",
		"yoast alternative",
		"wordpress redirects",
	],
	"repo": "https://github.com/moorage-dev/moorage",
	"sections": {
		"description": { "file": "listing/description.md" },
		"installation": { "file": "listing/installation.md" },
		"faq": { "file": "listing/faq.md" },
		"security": { "file": "listing/security.md" },
	},
	// Registry listing only: the EmDash version a site needs, and the gallery.
	"release": {
		"requires": { "env:emdash": ">=1.2.0" },
		"artifacts": {
			// The Moorage cleat (moorage.dev/logo.png), the same on every plugin.
			"icon": { "file": "./images/icon.png" },
			"screenshots": [
				{ "file": "./images/overview.png", "lang": "en" },
				{ "file": "./images/google-preview.png", "lang": "en" },
				{ "file": "./images/redirects.png", "lang": "en" },
				{ "file": "./images/settings.png", "lang": "en" },
			],
		},
	},
	"publisher": "did:plc:cus3srdqglppyowqrw3hvjfj",

	"license": "MIT",
	"author": { "name": "Moorage", "url": "https://moorage.dev" },
	"security": { "email": "security@moorage.dev" },

	// Trust contract — what runtime APIs the plugin asks for.
	// Empty arrays mean no extra privileges beyond logging,
	// KV, and route/hook registration. Changing these between
	// releases requires a version bump because installed
	// users have consented to the old contract.
	"capabilities": ["content:read", "bylines:read", "schema:read", "redirects:write"],
	"allowedHosts": [],
	"admin": {
		"pages": [{ "path": "/overview", "label": "SEO", "icon": "search", "group": "Marketing" }],
		"widgets": [{ "id": "seo", "title": "SEO", "size": "third" }],
		"editorPanels": [{ "id": "preview", "title": "Google preview", "route": "editor/preview" }],
	},
	"storage": {
		// One record per content entry: dates, authors, schema type, extra JSON-LD.
		"entries": { "indexes": ["status", "titleKey"] },
	},
}
