//
// EmDash's embed block (links, mostly from imported posts). Whatever EmDash
// renders as a YouTube or Vimeo player, or oEmbed code with a YouTube, Vimeo or
// Google iframe, is held back where the cookie banner can ask (heldEmbed in
// held.mjs); anything else, and every embed where nobody is asked, renders
// exactly as EmDash renders it.
import { Embed } from "emdash/ui";

import { heldEmbed } from "./held.mjs";
import { holding } from "./holding.mjs";
import Held from "./Held.astro";

const { node } = Astro.props as { node?: { url?: unknown; provider?: unknown; html?: unknown } };
const held = heldEmbed(node);
const hold = held ? await holding(Astro.locals, Astro.url, held.name) : false;
---

{
	hold && held ? (
		<Held kind={held.kind} name={held.name} link={held.link}>
			<Embed node={node as never} />
		</Held>
	) : (
		<Embed node={node as never} />
	)
}
