//
// EmDash's embed block (links, mostly from imported posts). A YouTube or Vimeo
// video is held back where the cookie banner can ask; anything else, and every
// embed where nobody is asked, renders exactly as EmDash renders it.
import { Embed } from "emdash/ui";

import { heldKind } from "./held.mjs";
import { holding } from "./holding.mjs";
import Held from "./Held.astro";

const { node } = Astro.props as { node?: { url?: unknown; provider?: unknown } };
const local = node?.provider === "video" || node?.provider === "audio";
// Only what EmDash's Embed renders as a player (its own two patterns); a link stays a link.
const url = typeof node?.url === "string" ? node.url : "";
const player =
	/(?:youtube\.com\/(?:watch\?v=|embed\/)|youtu\.be\/)[a-zA-Z0-9_-]{11}/.test(url) ||
	/vimeo\.com\/\d+/.test(url);
const found = local || !player ? undefined : heldKind(url);
const held = found?.kind === "video" ? found : undefined;
const hold = held ? await holding(Astro.locals, Astro.url) : false;
---

{
	hold && held ? (
		<Held kind={held.kind} name={held.name} link={held.link}>
			<Embed node={node as never} />
		</Held>
	) : (
		<Embed node={node as never} />
	)
}
