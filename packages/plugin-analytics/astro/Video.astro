//
// The official Embeds plugin's `youtube` and `vimeo` blocks, when this plugin is
// listed after it in astro.config.mjs (the later plugin's renderer wins). Its
// own player cannot be reached from here, so the video plays in the standard
// player: YouTube's privacy-enhanced one, Vimeo's with do-not-track. Held back
// where the cookie banner can ask, like the others.
import { heldVideo } from "./held.mjs";
import { holding } from "./holding.mjs";
import Held from "./Held.astro";

const { node } = Astro.props as {
	node?: { _type?: unknown; id?: unknown; title?: unknown };
};
const type = node?._type === "vimeo" ? "vimeo" : "youtube";
const held = heldVideo(type, node?.id);
const hold = held ? await holding(Astro.locals, Astro.url) : false;
const title =
	typeof node?.title === "string" && node.title ? node.title : `${held?.name ?? "Video"} video`;
---

{
	held &&
		(hold ? (
			<Held kind={held.kind} name={held.name} link={held.link}>
				<div class="cc-held-video">
					<iframe
						src={held.player}
						title={title}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					/>
				</div>
			</Held>
		) : (
			<div class="cc-held cc-held-open">
				<style is:inline>
					{
						".cc-held-video{position:relative;aspect-ratio:16/9;margin:1.5rem 0}.cc-held-video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}"
					}
				</style>
				<div class="cc-held-video">
					<iframe
						src={held.player}
						title={title}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					/>
				</div>
			</div>
		))
}
