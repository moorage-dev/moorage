{
	"name": "@moorage/plugin-analytics",
	"version": "0.0.0",
	"description": "Analytics & Cookie Consent for EmDash: Google Analytics, Google Tag Manager, Meta Pixel, Microsoft Clarity, HubSpot and Cloudflare Web Analytics with a cookie banner that holds them back until the visitor agrees.",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"google analytics",
		"google tag manager",
		"facebook pixel",
		"microsoft clarity",
		"cookie consent",
		"cookie banner",
		"consent mode",
		"gdpr"
	],
	"license": "FSL-1.1-MIT",
	"author": "Moorage (https://moorage.dev)",
	"homepage": "https://github.com/moorage-dev/moorage/tree/main/packages/plugin-analytics#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moorage-dev/moorage.git",
		"directory": "packages/plugin-analytics"
	},
	"bugs": "https://github.com/moorage-dev/moorage/issues",
	"publishConfig": {
		"access": "public"
	},
	"private": true,
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"emdash": ">=1.2.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "catalog:",
		"@moorage/typescript-config": "workspace:*",
		"emdash": "catalog:",
		"happy-dom": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
