{
	"name": "@moorage/plugin-analytics",
	"version": "0.4.0",
	"description": "Google Analytics, Tag Manager, Meta Pixel, Clarity, LinkedIn, TikTok, Plausible and Umami for EmDash, with a cookie consent banner in seven languages that holds them, and YouTube and Maps embeds, back until the visitor agrees.",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"emdash-cms",
		"cms",
		"analytics",
		"google-analytics",
		"ga4",
		"google-tag-manager",
		"gtm",
		"meta-pixel",
		"facebook-pixel",
		"microsoft-clarity",
		"hubspot",
		"plausible",
		"umami",
		"linkedin-insight-tag",
		"tiktok-pixel",
		"cookie-consent",
		"cookie-banner",
		"consent-mode",
		"gdpr"
	],
	"license": "MIT",
	"author": "Moorage (https://moorage.dev)",
	"homepage": "https://moorage.dev/plugins/analytics",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moorage-dev/moorage.git",
		"directory": "packages/plugin-analytics"
	},
	"bugs": "https://github.com/moorage-dev/moorage/issues",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./astro": "./astro/index.mjs"
	},
	"files": [
		"dist",
		"astro",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"astro": ">=6.0.0",
		"emdash": ">=1.2.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "catalog:",
		"astro": "catalog:",
		"@moorage/typescript-config": "workspace:*",
		"emdash": "catalog:",
		"happy-dom": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
