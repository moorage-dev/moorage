{
	"name": "@moorage/plugin-analytics",
	"version": "0.2.4",
	"description": "Google Analytics, Google Tag Manager, Meta Pixel and Clarity for EmDash, with a cookie consent banner that holds them back until the visitor agrees.",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"emdash-cms",
		"cms",
		"analytics",
		"google-analytics",
		"ga4",
		"google-tag-manager",
		"gtm",
		"meta-pixel",
		"facebook-pixel",
		"microsoft-clarity",
		"hubspot",
		"cookie-consent",
		"cookie-banner",
		"consent-mode",
		"gdpr"
	],
	"license": "MIT",
	"author": "Moorage (https://moorage.dev)",
	"homepage": "https://moorage.dev/plugins/analytics",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moorage-dev/moorage.git",
		"directory": "packages/plugin-analytics"
	},
	"bugs": "https://github.com/moorage-dev/moorage/issues",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"emdash": ">=1.2.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "catalog:",
		"@moorage/typescript-config": "workspace:*",
		"emdash": "catalog:",
		"happy-dom": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
