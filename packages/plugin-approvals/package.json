{
	"name": "@moorage/plugin-approvals",
	"version": "0.1.6",
	"description": "Content approval for EmDash: Publish sends a page for approval; approve and publish in one step, or send it back with a note.",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"emdash-cms",
		"cms",
		"content approval",
		"editorial workflow",
		"publish approval",
		"review"
	],
	"license": "MIT",
	"author": "Moorage (https://moorage.dev)",
	"homepage": "https://moorage.dev/plugins/approvals",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moorage-dev/moorage.git",
		"directory": "packages/plugin-approvals"
	},
	"bugs": "https://github.com/moorage-dev/moorage/issues",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"!dist/*.tar.gz",
		"emdash-plugin.jsonc",
		"listing",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"registry:publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.3.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "catalog:",
		"@emdash-cms/plugin-cli": "catalog:",
		"@emdash-cms/plugin-test": "catalog:",
		"@moorage/typescript-config": "workspace:*",
		"emdash": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
