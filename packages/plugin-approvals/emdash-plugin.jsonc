{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "approvals",
	// Listing text. Registry search matches exact phrases in name, description,
	// keywords and sections, so the phrases people type appear verbatim.
	"name": "Content Approval",
	"description": "Content approval for EmDash: Publish sends a page for approval; approve and publish in one step, or send it back with a note.",
	"keywords": ["content approval", "editorial workflow", "publish approval", "review", "sign off"],
	"repo": "https://github.com/moorage-dev/moorage",
	"sections": {
		"description": { "file": "listing/description.md" },
		"installation": { "file": "listing/installation.md" },
		"faq": { "file": "listing/faq.md" },
		"security": { "file": "listing/security.md" },
	},
	// Registry listing only: the EmDash version a site needs, and the gallery.
	"release": {
		"requires": { "env:emdash": ">=1.3.0" },
		"artifacts": {
			// This plugin's own glyph on the Moorage land tile, from icon.svg (scripts/render-banners.mjs in apps/demo-site).
			"icon": { "file": "./images/icon.png" },
			// Cover at the top of the listing and its share image: 3:1, from banner.svg (scripts/render-banners.mjs in apps/demo-site).
			"banner": { "file": "./images/banner.png" },
			"screenshots": [
				{ "file": "./images/review-panel-0-2-1.png", "lang": "en" },
				{ "file": "./images/waiting-0-2-1.png", "lang": "en" },
				{ "file": "./images/settings-0-2-1.png", "lang": "en" },
				{ "file": "./images/held-publish-0-2-1.png", "lang": "en" },
			],
		},
	},
	"publisher": "did:plc:cus3srdqglppyowqrw3hvjfj",

	"license": "MIT",
	"author": { "name": "Moorage", "url": "https://moorage.dev" },
	"security": { "email": "security@moorage.dev" },

	// Trust contract. Holding a publish needs the content-policy hook; reading the saved
	// draft needs revisions; "Approve and publish" needs content:publish; approvers' names
	// and emails need users:read.
	"capabilities": [
		"hooks.content-policy:register",
		"content:read",
		"content:revisions:read",
		"content:publish",
		"schema:read",
		"users:read",
		"email:send",
	],
	"allowedHosts": [],
	"admin": {
		"pages": [
			{ "path": "/overview", "label": "Approvals", "icon": "check-circle", "group": "Content" },
		],
		"widgets": [{ "id": "approvals", "title": "Approvals", "size": "third" }],
		"editorPanels": [{ "id": "approval", "title": "Approval", "route": "editor/panel" }],
		"editorActions": [
			{ "id": "ask", "label": "Ask for approval", "route": "editor/ask", "placement": "toolbar" },
		],
	},
	"storage": {
		// One record per content entry: the open request and its history.
		"requests": { "indexes": ["status", "updatedAt"] },
		// A text copy of each approved version.
		"versions": { "indexes": ["requestKey"] },
	},
}
