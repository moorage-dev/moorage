//
// A "Box in a page": the "Popups box" block an editor places in a post or page.
// Page content, not an overlay: no close button, no trigger. A form inside it is
// the forms plugin's own block component, so every form feature works here,
// Turnstile and file uploads included. Read on the server through the site's
// own public route, so a box that is off or ended renders nothing.
import { getPublicPluginApiRouteHandler } from "emdash/plugin-utils";
import { pluginBlockComponents } from "virtual:emdash/block-components";

interface Box {
	id: string;
	/** For the form's hidden utm_campaign field (older servers leave it out). */
	handle?: string;
	heading: string;
	text: string;
	picture: { url: string; alt: string; width: number | null; height: number | null } | null;
	form: string;
	button: { label: string; url: string } | null;
	scheme: "auto" | "light" | "dark";
	/** The look's colours, and the button's words on them (older servers leave those out). */
	colors: { background: string; text: string; accent: string; accentText?: string } | null;
	/** A colour set's dark version, for a dark device (older servers leave it out). */
	darkColors?: { background: string; text: string; accent: string; accentText?: string } | null;
}

const { node } = Astro.props as { node?: { popup?: string } };
const handle = getPublicPluginApiRouteHandler(Astro.locals);
let box: Box | null = null;
if (handle && typeof node?.popup === "string") {
	try {
		const answer = (await handle(
			"popups",
			"POST",
			"/box",
			new Request(new URL("/_emdash/api/plugins/popups/box", Astro.url), {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ id: node.popup }),
			}),
		)) as { success?: boolean; data?: { box?: Box | null } } | null;
		box = answer?.success ? (answer.data?.box ?? null) : null;
	} catch {
		box = null;
	}
}
const FormEmbed = box?.form
	? ((pluginBlockComponents as Record<string, unknown>)["emdash-form"] as
			| ((props: { node: { formId: string } }) => unknown)
			| undefined)
	: undefined;
const vars = (c: NonNullable<Box["colors"]>, important = "") =>
	`--popups-background:${c.background}${important};--popups-surface:${c.background}${important};--popups-text:${c.text}${important};--popups-accent:${c.accent}${important};` +
	(c.accentText ? `--popups-accent-text:${c.accentText}${important};` : "");
const own = box?.colors ? vars(box.colors) : "";
// A colour set's dark version wins over the light one on a dark device. The id is letters and digits.
const ownDark = box?.darkColors
	? `@media (prefers-color-scheme:dark){[data-popups-box="${box.id}"]{${vars(box.darkColors, " !important")}}}`
	: "";
// Inline, once per box: a block loaded through EmDash's plugin components is not part of the
// page's own style graph, so a component stylesheet would not always reach the page.
// The form rules count as one element (`:where()` drops the classes): they still beat a theme's
// bare `input {}` or `button {}` (they come later in the page), and a site's own `.ec-form-*`
// rules beat them, so a site that styles its forms keeps that look inside the box.
const css = `
.popups-box{--pb-text:var(--popups-text,var(--cookie-consent-text,currentColor));position:relative;max-width:640px;margin:28px 0;padding:24px;color:var(--pb-text);background:var(--popups-surface,var(--cookie-consent-surface,color-mix(in srgb,currentColor 6%,transparent)));border:1px solid var(--popups-rule,var(--cookie-consent-rule,color-mix(in srgb,currentColor 32%,transparent)));border-radius:10px;font-family:var(--popups-font,var(--cookie-consent-font))}
.popups-box h2{margin:0;font-weight:600;font-size:22px;line-height:1.25;font-family:var(--popups-heading-font,var(--cookie-consent-heading-font))}
.popups-box>p{margin:6px 0 0}
.popups-box .popups-box-pic{display:block;width:calc(100% + 48px);max-width:none;height:180px;margin:-24px -24px 18px;object-fit:cover;border-radius:9px 9px 0 0}
:where(.popups-box) form:where(.ec-form){margin-top:16px}
:where(.popups-box .ec-form) fieldset:where(.ec-form-page){border:0;margin:0;padding:0;min-width:0;display:grid;gap:12px}
:where(.popups-box .ec-form) label:where(.ec-form-label){display:block;font-weight:600;font-size:15px;margin-bottom:4px}
:where(.popups-box .ec-form) span:where(.ec-form-required){margin-left:2px}
:where(.popups-box .ec-form) :is(input,textarea,select):where(.ec-form-input:not([type=checkbox]):not([type=radio])){display:block;box-sizing:border-box;width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--popups-rule,var(--cookie-consent-rule,color-mix(in srgb,currentColor 32%,transparent)));border-radius:6px;background:var(--popups-background,var(--cookie-consent-background,Canvas));color:inherit;font-size:16px;font-family:inherit}
:where(.popups-box .ec-form) div:where(.ec-form-nav){margin-top:14px}
:where(.popups-box .ec-form) button:where(.ec-form-submit),.popups-box .popups-box-button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 20px;border-radius:6px;border:2px solid var(--popups-accent,var(--cookie-consent-accent,#141414));background:var(--popups-accent,var(--cookie-consent-accent,#141414));color:var(--popups-accent-text,var(--cookie-consent-accent-text,#fff));font-weight:600;font-size:16px;line-height:1.2;font-family:inherit;text-decoration:none;cursor:pointer}
:where(.popups-box .ec-form) div:where(.ec-form-status:not(:empty)){margin-top:10px;font-weight:600}
:where(.popups-box .ec-form) span:where(.ec-form-error:empty){display:none}
.popups-box .popups-box-go{margin-top:18px}
.popups-box :focus-visible{outline:3px solid var(--pb-text);outline-offset:2px}
@media (max-width:600px){.popups-box{padding:20px}.popups-box .popups-box-pic{width:calc(100% + 40px);margin:-20px -20px 16px;height:140px}}
`;
const headingId = box ? `popups-box-${box.id}-${Math.random().toString(36).slice(2, 7)}` : "";
---

{
	box && (
		<section
			class="popups-box"
			data-popups-box={box.id}
			data-popups-handle={box.handle}
			data-scheme={box.scheme}
			role="region"
			aria-labelledby={headingId}
			style={own || undefined}
		>
			<style is:inline set:html={css + ownDark} />
			{box.picture && (
				<img
					class="popups-box-pic"
					src={box.picture.url}
					alt={box.picture.alt}
					width={box.picture.width ?? undefined}
					height={box.picture.height ?? undefined}
					loading="lazy"
				/>
			)}
			<h2 id={headingId}>{box.heading}</h2>
			{box.text && <p>{box.text}</p>}
			{FormEmbed && <FormEmbed node={{ formId: box.form }} />}
			{box.form && !FormEmbed && (
				<p class="popups-box-note">This form is not available right now.</p>
			)}
			{box.button && (
				<p class="popups-box-go">
					<a class="popups-box-button" href={box.button.url} data-popups-go>
						{box.button.label}
					</a>
				</p>
			)}
		</section>
	)
}



<script>
	// Counts for a box in a page: seen (half of it on screen for a second), a sign-up through
	// its form, a click on its button. Nothing about the visitor; signed-in staff are not counted.
	const api = "/_emdash/api/plugins/popups/count";
	let staff = !!document.getElementById("emdash-toolbar");
	try {
		staff = staff || !!localStorage.getItem("emdash-editor");
	} catch {
		// Storage blocked: a visitor.
	}
	const send = (id: string, event: string) => {
		if (staff || !navigator.sendBeacon) return;
		navigator.sendBeacon(
			api,
			new Blob([JSON.stringify({ p: id, e: event, m: innerWidth < 768 })], {
				type: "application/json",
			}),
		);
	};
	for (const box of document.querySelectorAll<HTMLElement>("[data-popups-box]")) {
		if (box.dataset.popupsWired) continue;
		box.dataset.popupsWired = "1";
		const id = box.dataset.popupsBox!;
		// The form's own hidden campaign fields, if it has them and they are empty: Forms then
		// shows which box a sign-up came from. Filled again just before it sends (capture runs
		// before the forms plugin's own handler), in case its script restored a saved page.
		const tags: Record<string, string> = {
			utm_source: "popups",
			utm_medium: "popup",
			utm_campaign: box.dataset.popupsHandle ?? "",
			page_url: location.origin + location.pathname,
		};
		const tag = () => {
			for (const input of box.querySelectorAll<HTMLInputElement>("form input[type=hidden][name]"))
				if (tags[input.name] && !input.value) input.value = tags[input.name]!;
		};
		tag();
		box.addEventListener("submit", tag, true);
		let timer: ReturnType<typeof setTimeout> | undefined;
		const watch = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					clearTimeout(timer);
					if (entry.isIntersecting) {
						timer = setTimeout(() => {
							send(id, "seen");
							watch.disconnect();
						}, 1000);
					}
				}
			},
			{ threshold: 0.5 },
		);
		watch.observe(box);
		box.addEventListener("click", (event) => {
			if ((event.target as Element).closest("[data-popups-go]")) send(id, "clicked");
		});
		let sent = false;
		new MutationObserver(() => {
			if (!sent && box.querySelector("[data-form-status].ec-form-status--success")) {
				sent = true;
				send(id, "sent");
			}
		}).observe(box, { subtree: true, attributes: true, attributeFilter: ["class"] });
	}
</script>
