{
	"name": "@moorage/plugin-lead-delivery",
	"version": "0.4.2",
	"description": "Send EmDash form enquiries to HubSpot, Zapier, Make, n8n or email, with a delivery log, retries and an alert when one fails.",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"emdash-cms",
		"cms",
		"forms",
		"leads",
		"hubspot",
		"zapier",
		"webhooks",
		"email"
	],
	"license": "MIT",
	"author": "Moorage (https://moorage.dev)",
	"homepage": "https://moorage.dev/plugins/lead-delivery",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/moorage-dev/moorage.git",
		"directory": "packages/plugin-lead-delivery"
	},
	"bugs": "https://github.com/moorage-dev/moorage/issues",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"!dist/*.tar.gz",
		"emdash-plugin.jsonc",
		"listing",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"registry:publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.3.0"
	},
	"devDependencies": {
		"@emdash-cms/blocks": "catalog:",
		"@emdash-cms/cloudflare": "catalog:",
		"@emdash-cms/plugin-cli": "catalog:",
		"@emdash-cms/plugin-test": "catalog:",
		"@moorage/typescript-config": "workspace:*",
		"emdash": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
